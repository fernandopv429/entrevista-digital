      "type": "string"
    },
    "folgas_trabalhadas": {
      "type": "boolean"
    },
    "ft_quantidade": {
      "type": "string"
    },
    "ft_valor": {
      "type": "string"
    },
    "ft_pagamento": {
      "type": "string"
    },
    "ft_comprovante": {
      "type": "boolean"
    },
    "intervalo_suprimido": {
      "type": "boolean"
    },
    "intervalo_detalhes": {
      "type": "string"
    },
    "horas_extras": {
      "type": "boolean"
    },
    "media_horas_extras": {
      "type": "string"
    },
    "periodo_antecedente": {
      "type": "string"
    },
    "periodo_sucedente": {
      "type": "string"
    },
    "acumulo_funcao": {
      "type": "boolean"
    },
    "funcoes_acumuladas": {
      "type": "string"
    },
