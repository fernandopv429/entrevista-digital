      "type": "string",
      "format": "date"
    },
    "vale_refeicao": {
      "type": "boolean"
    },
    "vale_alimentacao": {
      "type": "boolean"
    },
    "vale_transporte": {
      "type": "boolean"
    },
    "finais_semana": {
      "type": "boolean"
    },
    "ferias": {
      "type": "boolean"
    },
