    },
    "estado_civil": {
      "type": "string"
    },
    "rg": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "pis": {
      "type": "string"
    },
    "ctps": {
      "type": "string"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date"
    },
    "filiacao": {
      "type": "string"
    },
